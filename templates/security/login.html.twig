{% extends 'base.html.twig' %}

{% block title %}Вхід адміністратора{% endblock %}

{% block body %}
    <section class="login-panel">
        <p class="eyebrow">Панель керування</p>
        <h1>Вхід адміністратора</h1>
        {% if error %}
            <p class="error">Неправильна email-адреса або пароль.</p>
        {% endif %}
        <form method="post" action="{{ path('app_login') }}">
            <label for="email">Email</label>
            <input id="email" type="email" name="email" value="{{ last_username }}" autocomplete="username" required autofocus>
            <label for="password">Пароль</label>
            <input id="password" type="password" name="password" autocomplete="current-password" required>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit">Увійти</button>
        </form>
    </section>
{% endblock %}
