{
    "name": "student/space-catalog",
    "description": "Каталог космічних об'єктів на Symfony",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-mbstring": "*",
        "ext-pdo_sqlite": "*",
        "doctrine/doctrine-bundle": "^2.14",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.3",
        "easycorp/easyadmin-bundle": "^5.0",
        "symfony/asset": "^7.4",
        "symfony/console": "^7.4",
        "symfony/doctrine-bridge": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/form": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/runtime": "^7.4",
        "symfony/security-bundle": "^7.4",
        "symfony/translation": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/validator": "^7.4",
        "symfony/var-exporter": "^7.4",
        "symfony/yaml": "^7.4",
        "twig/extra-bundle": "^3.15",
        "twig/twig": "^3.15"
    },
    "require-dev": {
        "symfony/maker-bundle": "^1.64"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php bin/console assets:install public --no-interaction"
        ],
        "post-update-cmd": [
            "@php bin/console assets:install public --no-interaction"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    }
}
